# Program 3: Fibonacci Number Calculation
# Result in r3

    eketsa_e r4, r0, 5       # N = 5
    eketsa_e r3, r0, 0       # Fib(0) = 0
    eketsa_e r5, r0, 1       # Fib(1) = 1

SEPO:
    lekana   r4, r0, FETA    # if N == 0 exit
    eketsa   r6, r3, r5      # temp = Fib(n-1) + Fib(n-2)
    eketsa   r3, r5, r0      # Fib(n-2) = Fib(n-1)
